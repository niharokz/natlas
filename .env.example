# Copy to .env and fill in. Never commit .env.

# Login. Prefer a hash over a plain password:
#   docker compose build
#   read -rs PW && printf '%s' "$PW" | docker run --rm -i natlas:local hash-password
NATLAS_USERNAME=admin
NATLAS_PASSWORD_HASH=
# NATLAS_PASSWORD=change-me        # plain-text alternative (not recommended)
# Signs the login cookie. Generate one with:  openssl rand -hex 32
NATLAS_SECRET_KEY=

# Folder on the host that holds your data files (event.md, inventory.csv, ...)
NATLAS_DATA_DIR=/path/to/your/data

# Timezone for "today", "overdue" and birthdays
TZ=Asia/Kolkata

# Run as this user so saved files belong to you (check with: id -u; id -g)
PUID=1000
PGID=1000

# Existing Docker network your reverse proxy is on
NATLAS_NETWORK=homelab

# Behind Caddy / Cloudflare: read the visitor IP from CF-Connecting-IP,
# X-Real-IP or the last X-Forwarded-For entry. Set false if Natlas is
# reachable directly (no proxy in front).
# NATLAS_TRUST_PROXY=true

# Only for testing over plain http (e.g. http://localhost:8080):
# NATLAS_COOKIE_SECURE=false
