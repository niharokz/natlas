# Natlas settings. Copy to .env (never committed) or add these lines to a shared
# homelab .env: docker-compose.yml passes only NATLAS_* and TZ into the container.
# Check them with:  docker compose run --rm natlas check

# ── login ────────────────────────────────────────────────────────────────────
# The single user. Store a password hash, not the password:
#   docker compose build
#   read -rs PW && printf '%s' "$PW" | docker run --rm -i natlas:local hash-password
NATLAS_USERNAME=admin
NATLAS_PASSWORD_HASH=
# Plain-text alternative, ignored when a hash is set (not recommended)
# NATLAS_PASSWORD=

# Signs the login cookie; changing it signs everyone out.  openssl rand -hex 32
NATLAS_SECRET_KEY=

# Optional. A browser given this key (app → This device) stays signed in until
# logout; others after NATLAS_SESSION_HOURS. Changing it signs those browsers out.
NATLAS_DEVICE_KEY=

# Optional read-only demo login, shown on the sign-in screen. It sees only a
# copy of the built-in sample data. The name must differ from NATLAS_USERNAME.
NATLAS_DEMO_USERNAME=
NATLAS_DEMO_PASSWORD=

# ── folders ──────────────────────────────────────────────────────────────────
# Host folder with your data files (event.md, inventory.csv, …), mounted at /data
NATLAS_DATA_DIR=/path/to/your/data
# Host folder for natlas.yml, layout.yml, bans.yml and demo/ (writable by PUID).
# NATLAS_CONFIG_DIR=./config

# ── machine (usually shared by every stack) ──────────────────────────────────
TZ=Asia/Kolkata          # "today", "overdue" and calendar dates
PUID=1000                # the container runs as this user (id -u; id -g),
PGID=1000                # so saved files stay yours

# ── defaults, change only if needed ──────────────────────────────────────────
# NATLAS_NETWORK=homelab          # existing Docker network of your reverse proxy
# NATLAS_SESSION_HOURS=12         # login life without the device key
# NATLAS_MAX_FAILURES=5           # failed logins per day before a public IP is banned …
# NATLAS_BAN_DAYS=7               # … for this many days (unban: docker exec natlas /natlas unban <ip>)
# NATLAS_TRUST_PROXY=true         # read the visitor IP from CF-Connecting-IP / X-Real-IP / last X-Forwarded-For
# NATLAS_COOKIE_SECURE=true       # false only for plain-http testing
# NATLAS_MAIN=true                # this copy merges Syncthing conflict copies (exactly one device should)
