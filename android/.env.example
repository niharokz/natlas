# Copy to android/.env (gitignored). Used only by android/build.sh.

# Password for your signing key (pick a long one and save it in your password manager).
NATLAS_KEYSTORE_PASSWORD=change-me-to-something-long
# Alias of the key inside the keystore.
NATLAS_KEY_ALIAS=natlas
# Folder that holds natlas.jks (outside the repo). Default: $KEYS_HOME/.natlas-keys
# (KEYS_HOME from ~/.zprofile, else ~/.local/share/keys)
NATLAS_KEYSTORE_DIR=

# Speed (optional). Phone CPUs to build the engine for; most phones need only arm64-v8a.
# NATLAS_ABIS=arm64-v8a
# Skip the Go and Android tests (./android/build.sh quick does this for you).
# NATLAS_QUICK=1
