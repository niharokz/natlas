<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon: jump straight in. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="quick" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="@string/sc_quick">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.natlas" android:targetClass="app.natlas.QuickAddActivity" />
    </shortcut>
    <shortcut android:shortcutId="today" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="@string/sc_today">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.natlas" android:targetClass="app.natlas.MainActivity">
            <extra android:name="route" android:value="#/today" />
        </intent>
    </shortcut>
    <shortcut android:shortcutId="calendar" android:enabled="true" android:icon="@mipmap/ic_launcher" android:shortcutShortLabel="@string/sc_calendar">
        <intent android:action="android.intent.action.VIEW" android:targetPackage="app.natlas" android:targetClass="app.natlas.MainActivity">
            <extra android:name="route" android:value="#/p/calendar" />
        </intent>
    </shortcut>
</shortcuts>
