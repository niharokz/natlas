<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: Clock (sample data). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="9:41" android:textSize="40sp" android:textColor="@color/w_text" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Monday, 19 Oct" android:textSize="14sp" android:textColor="@color/accent" android:maxLines="1" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_dot" android:tint="#4285F4" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Team lunch" android:textSize="14sp" android:textColor="@color/w_text" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1:00 pm" android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="4dp" android:layout_marginEnd="12dp" android:src="@drawable/widget_dot" android:tint="#4285F4" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Call bank about card" android:textSize="14sp" android:textColor="@color/w_text" android:maxLines="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
