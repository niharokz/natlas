<?xml version="1.0" encoding="utf-8"?>
<!-- Quick add at 1×1: just the plus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <ImageView android:id="@+id/add" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="center"
        android:padding="10dp" android:src="@drawable/ic_plus" android:contentDescription="Add" android:background="@drawable/widget_add_circle" />
</FrameLayout>
