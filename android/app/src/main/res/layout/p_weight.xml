<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: Weight (sample data). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Weight · today" android:textSize="11sp" android:textColor="@color/w_muted" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="66.1 kg" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/w_text" android:maxLines="1" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="−0.8 kg in 30 days" android:textSize="11sp" android:textColor="@color/accent" android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
