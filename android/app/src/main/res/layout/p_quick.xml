<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview: Quick add (sample data). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="8dp">
        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_logo_mono" android:tint="@color/accent" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Add to Events…" android:textSize="15sp" android:textColor="@color/w_muted" android:maxLines="1" android:layout_marginStart="12dp" android:layout_weight="1"/>
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:padding="8dp" android:src="@drawable/ic_plus" android:tint="#FFFFFF" android:background="@drawable/widget_add_circle" />
    </LinearLayout>
</FrameLayout>
