<?xml version="1.0" encoding="utf-8"?>
<!-- Clock + agenda (4×2): time, date and the next three items. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="16dp" android:paddingEnd="14dp" android:paddingTop="10dp" android:paddingBottom="10dp">
        <LinearLayout android:id="@+id/head" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
            <TextClock android:id="@+id/time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm" android:format24Hour="HH:mm" android:textSize="40sp" android:includeFontPadding="false" />
            <TextClock android:id="@+id/date" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:layout_marginBottom="4dp" android:format12Hour="EEEE, d MMM" android:format24Hour="EEEE, d MMM"
                android:textSize="14sp" android:maxLines="1" />
        </LinearLayout>
        <FrameLayout android:layout_width="match_parent" android:layout_height="8dp" />
        <LinearLayout android:id="@+id/a0" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/row_ripple">
            <ImageView android:id="@+id/ad0" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/at0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/aw0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/a1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/row_ripple">
            <ImageView android:id="@+id/ad1" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/at1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/aw1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/a2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:background="@drawable/row_ripple">
            <ImageView android:id="@+id/ad2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="10dp" android:src="@drawable/widget_dot" android:importantForAccessibility="no" />
            <TextView android:id="@+id/at2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/aw2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="8dp" android:textSize="12sp" />
        </LinearLayout>
        <TextView android:id="@+id/empty" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
