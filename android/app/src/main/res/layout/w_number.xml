<?xml version="1.0" encoding="utf-8"?>
<!-- Number (2×1, 2×2): one figure from the Today screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="12dp">
        <TextView android:id="@+id/sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" android:textAllCaps="true" android:maxLines="1" />
        <TextView android:id="@+id/value" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="30sp" android:textStyle="bold" android:maxLines="1" android:includeFontPadding="false" />
        <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
