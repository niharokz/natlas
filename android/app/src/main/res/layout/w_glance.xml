<?xml version="1.0" encoding="utf-8"?>
<!-- Glance (4×1): up to four numbers of one list side by side. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent">
    <ImageView android:id="@+id/bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_shape" android:scaleType="fitXY" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="8dp"
            android:textSize="10sp" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" android:textAllCaps="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <LinearLayout android:id="@+id/g0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:background="@drawable/row_ripple">
                <TextView android:id="@+id/v0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/l0" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/g1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:background="@drawable/row_ripple">
                <TextView android:id="@+id/v1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/l1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/g2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:background="@drawable/row_ripple">
                <TextView android:id="@+id/v2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/l2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <LinearLayout android:id="@+id/g3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:background="@drawable/row_ripple">
                <TextView android:id="@+id/v3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="20sp" android:textStyle="bold" android:maxLines="1" />
                <TextView android:id="@+id/l3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textSize="10sp" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
