<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app: follows the phone's light/dark, with the Natlas splash on Android 12+. -->
    <style name="Theme.Natlas" parent="android:Theme.DeviceDefault.DayNight">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/icon_bg</item>
    </style>
    <!-- Widget router: no window at all. -->
    <style name="Theme.Natlas.Invisible" parent="android:Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
    <!-- Quick add and widget setup: a floating card. -->
    <style name="Theme.Natlas.Dialog" parent="android:Theme.DeviceDefault.Light.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
